use v5.32;
use strict;
use warnings;

use lib 't/lib';

use Test::More;
use Scalar::Util qw(blessed);

use Elegant::Perl ();
use Elegant::Test qw(
    define_class
    exception
);

my ($ok, $error) = define_class(
    'T::Object::Money',
    q{
        field 'currency';
        field 'amount';
    },
);

ok($ok, 'basic Elegant class compiles')
    or diag $error;

my $money = T::Object::Money->new(
    currency => 'USD',
    amount   => 12.50,
);

is(
    blessed($money),
    'T::Object::Money',
    'constructor returns the requested class',
);

$error = exception(
    sub {
        my $value = $money->{amount};
    }
);

like(
    $error,
    qr/(?:Not a HASH reference|Can't use .* as a HASH ref)/,
    'object fields are not available through hash dereference',
);

$error = exception(
    sub {
        $money->value('amount');
    }
);

like(
    $error,
    qr/value\(\) is private to package T::Object::Money/,
    'value() cannot be called as a public method',
);

$error = exception(
    sub {
        no strict 'refs';
        &{'T::Object::Money::value'}(
            $money,
            'amount',
        );
    }
);

like(
    $error,
    qr/value\(\) is private to package T::Object::Money/,
    'qualified value() call from another package is rejected',
);

$error = exception(
    sub {
        T::Object::Money->new(
            currency => 'USD',
        );
    }
);

like(
    $error,
    qr/missing required field 'amount'/,
    'all fields are required',
);

$error = exception(
    sub {
        T::Object::Money->new(
            currency => 'USD',
            amount   => 10,
            country  => 'US',
        );
    }
);

like(
    $error,
    qr/unknown field 'country'/,
    'unknown constructor fields are rejected',
);

$error = exception(
    sub {
        T::Object::Money->new(
            currency => 'USD',
            amount   => 10,
            amount   => 20,
        );
    }
);

like(
    $error,
    qr/field 'amount' specified more than once/,
    'duplicate constructor fields are rejected',
);

$error = exception(
    sub {
        T::Object::Money->new(
            currency => 'USD',
            'amount',
        );
    }
);

like(
    $error,
    qr/expects named parameters/,
    'odd constructor argument list is rejected',
);

$error = exception(
    sub {
        T::Object::Money->new(
            currency => undef,
            amount   => 10,
        );
    }
);

like(
    $error,
    qr/field 'currency' must contain a defined scalar or a blessed object/,
    'undef cannot enter object state',
);

for my $case (
    ['ARRAY',  []],
    ['HASH',   {}],
    ['SCALAR', \(my $scalar = 1)],
    ['CODE',   sub { 1 }],
) {
    my ($name, $value) = @$case;

    $error = exception(
        sub {
            T::Object::Money->new(
                currency => $value,
                amount   => 10,
            );
        }
    );

    like(
        $error,
        qr/must contain a defined scalar or a blessed object/,
        "unblessed $name reference cannot enter object state",
    );
}

{
    my $identity;
    my $object = bless \$identity, 'T::Object::Foreign';

    my $with_object = T::Object::Money->new(
        currency => $object,
        amount   => 10,
    );

    isa_ok(
        $with_object,
        'T::Object::Money',
        'blessed object is a legal field value',
    );
}

$error = exception(
    sub {
        T::Object::Money::new(
            'T::Object::Other',
            currency => 'USD',
            amount   => 10,
        );
    }
);

like(
    $error,
    qr/Cannot construct T::Object::Other via T::Object::Money/,
    'constructor cannot construct another class',
);

$error = exception(
    sub {
        $money->new(
            currency => 'USD',
            amount   => 10,
        );
    }
);

like(
    $error,
    qr/must be called as a class method/,
    'constructor cannot be called on an instance',
);

$error = exception(
    sub {
        eval q{
            package T::Object::Money;
            field 'late';
            1;
        } or die $@;
    }
);

like(
    $error,
    qr/object layout is already sealed/,
    'object layout is sealed after finalization',
);

{
    local $SIG{__WARN__} = sub {};

    my ($custom_ok, $custom_error) = define_class(
        'T::Object::CustomNew',
        q{
            field 'name';

            sub new {
                return bless {}, __PACKAGE__;
            }
        },
    );

    ok(!$custom_ok, 'custom constructor is rejected');

    like(
        $custom_error,
        qr/defines its own new\(\); constructors are generated by Elegant::Perl/,
        'custom constructor has a useful error',
    );
}

{
    my ($dup_ok, $dup_error) = define_class(
        'T::Object::DuplicateField',
        q{
            field 'name';
            field 'name';
        },
    );

    ok(!$dup_ok, 'duplicate field declaration is rejected');

    like(
        $dup_error,
        qr/field 'name' is already declared/,
        'duplicate field reports its name',
    );
}

done_testing;
